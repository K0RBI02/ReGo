:00:00Z","departureTimePlanned":"2026-10-11T09:00:00Z","arrivalTimeEstimated":"2026-10-11T09:00:00Z","departureTimeEstimated":"2026-10-11T09:01:00Z"},{"isGlobalId":true,"id":"de:09162:5:45:85","name":"Ostbahnhof","disassembledName":"5","type":"platform","pointType":"TRACK","coord":[48.127491,11.605209],"niveau":1,"parent":{"isGlobalId":true,"id":"de:09162:5","name":"Ostbahnhof","type":"stop","parent":{"id":"placeID:9162000:1","name":"München","type":"locality"},"properties":{"stopId":"91000005"},"coord":[48.12815,11.604545],"niveau":0},"productClasses":[0,1,2,4,5,7,13,17],"properties":{"AREA_NIVEAU_DIVA":"1","stoppingPointPlanned":"5","areaGid":"de:09162:5:45","area":"45","platform":"85","platformName":"5","plannedPlatformName":"5","accessArray":[{"stoppointAccess":{"height":760,"equipment":0,"maxWeight":0,"distanceTrack":0,"widthAvail":10300,"attributes":6,"stepFromStreet":0}}],"zone":"mvv:M"},"arrivalTimePlanned":"2026-10-11T09:02:00Z","arrivalTimeEstimated":"2026-10-11T09:03:00Z"}],"infos":[{"timestamps":{"creation":"2026-10-09T10:54:00Z"},"priority":"normal","id":"ems-1719","version":1,"type":"lineInfo","properties":{"publisher":"ems.comm.addinfo","infoType":"lineInfo","providerCode":"MVV_SUB"},"infoLinks":[{"urlText":"","url":"http://","content":"<div>\n<div>Auf Grund von Bauarbeiten zur 2. Stammstrecke kommt es von Freitag, 09.10.2026 (22:30 Uhr), bis Montag, 12.10.2026 (04:00 Uhr), zu Einschr&auml;nkungen auf den Linien S1 und S8 im Abschnitt zwischen Leuchtenbergring und Freising/Flughafen/Airport.</div>\n<div>S1 in und aus Richtung Freising/Flughafen beginnen beziehungsweise enden am Hauptbahnhof (Gleis 27 bis 36) und halten nicht an der Hackerbr&uuml;cke.<br />S8 beginnen beziehungsweise enden die Z&uuml;ge in und aus Richtung Flughafen in Johanneskirchen, die Z&uuml;ge in und aus Richtung Herrsching beginnen beziehungsweise enden am Leuchtenbergring. Zwischen Ostbahnhof und Johanneskirchen besteht Ersatzverkehr mit Bussen. Fahrg&auml;ste in Richtung Flughafen werden gebeten, bereits am Ostbahnhof in den Bus-Ersatzverkehr nach Johanneskirchen umzusteigen.</div>\n</div>","subtitle":"S1/S8: Fahrplanänderungen und Ersatzverkehr zwischen Leuchtenbergring und Freising/Flughafen/Airport (9. bis 12. Oktober 2026 Durchgehend)","additionalLinks":[{"id":"-1","url":"https://assets.static-bahn.de/dam/jcr%3A3dd8551f-8b4f-49a5-9c2b-cb0fb1118392/Fpl%20S%201%20Uml%20MMDN-MH%209-12%20Okt.91f646b2f10a7cf2cf2d1d1053a0b7c5.pdf","urlText":"Fahrplan S1 (PDF, 905 KB)","subtitle":"","properties":{"linkTarget":"_blank"}},{"id":"-1","url":"https://assets.static-bahn.de/dam/jcr%3Af6fa10c6-fc3c-47c3-b284-935d766cf55f/Fpl%20S%208%20SEV%20MOP-MJK%20%209-12%20Okt.57c08b3e3509c0441c90328316d7da47.pdf","urlText":"Fahrplan S8 (PDF, 1 MB)","subtitle":"","properties":{"linkTarget":"_blank"}}]}]},{"timestamps":{"creation":"2026-10-09T13:38:00Z"},"priority":"normal","id":"ems-1724","version":69,"type":"lineInfo","properties":{"publisher":"ems.comm.addinfo","infoType":"lineInfo","providerCode":"MVV_SUB"},"infoLinks":[{"urlText":"","url":"http://","content":"<div>\n<div>Ab dem 25. August 2026 ist aufgrund von Bauarbeiten am Bahnhof Laim bis Mitte 2028 mit &Auml;nderungen bei den Fahrten in Richtung M&uuml;nchner Innenstadt zu rechnen. Diese &Auml;nderungen betreffen ausschlie&szlig;lich die Fahrten in Richtung Innenstadt. Bei den Fahrten aus der Stadt heraus halten alle S-Bahn-Z&uuml;ge weiterhin wie gewohnt in Laim. Fahrg&auml;ste, die aus Richtung Pasing kommen und mit den Linien S3, S4, S6 oder S8 nach Laim fahren: Diese Linien halten in Richtung Stadtzentrum nicht mehr am Bahnhof Laim. Fahrg&auml;ste, die nach Laim fahren m&ouml;chten, werden gebeten, mit der S-Bahn bis Hirschgarten weiterzufahren, dort auf demselben Bahnsteig umzusteigen und dann mit der n&auml;chsten S-Bahn zur&uuml;ck nach Laim zu fahren.&nbsp; Mit einem f&uuml;r Laim g&uuml;ltigen Fahrschein ist es m&ouml;glich, bis Hirschgarten weiterzufahren und dann zur&uuml;ck nach Laim zu fahren. Durch den zus&auml;tzlichen Umstieg kann sich die Fahrzeit verl&auml;ngern. Den Fahrg&auml;sten wird empfohlen, vor Fahrtantritt die Anschlussinformationen zu &uuml;berpr&uuml;fen, die aktuellen Fahrgastinformationen im Zug und am Bahnhof zu beachten und insbesondere zu Beginn des Schuljahres sowie in den ersten Tagen des Betriebs die zus&auml;tzliche Fahrzeit einzuplanen. Kurz zusammengefasst:</div>\n<ul>\n<li>Bauarbeiten am Bahnhof Laim vom 25.08.2026 bis voraussichtlich Mitte 2028</li>\n<li>Die Linien S3, S4, S6 und S8 halten stadteinw&auml;rts nicht in Laim.</li>\n<li>Stadtausw&auml;rts ergeben sich keine &Auml;nderungen.</li>\n<li>Fahrg&auml;ste mit Ziel Laim fahren bitte bis Hirschgarten weiter, steigen dort um und fahren mit der n&auml;chsten S-Bahn zur&uuml;ck nach Laim.</li>\n<li>Kein zus&auml;tzliches Ticket erforderlich.</li>\n<li>Die Linien S1, S2 und S5 sind nicht betroffen und halten weiterhin in beiden Fahrtrichtungen in Laim.</li>\n</ul>\n</div>","subtitle":"S3/S4/S6/S8: Bauarbeiten am Bahnhof Laim (25. August 2026 bis voraussichtlich Mitte 2028)"}]}],"coords":[[48.137177,11.575293],[48.137031,11.575987],[48.136883,11.576463],[48.13647,11.577556],[48.136271,11.57817],[48.135793,11.580002],[48.135608,11.580621],[48.135451,11.581066999999999],[48.135305,11.581416],[48.135184,11.581677000000001],[48.134768,11.582161],[48.134212,11.583026],[48.133469,11.584173],[48.133182,11.584689],[48.132979,11.585109],[48.132797,11.585523],[48.132449,11.586381],[48.132332,11.586734],[48.131901,11.588445],[48.131767,11.588843],[48.131516,11.589387],[48.13119,11.589962],[48.13077,11.590607],[48.129895,11.591872],[48.12926,11.592838],[48.128694,11.593695],[48.12624,11.597774],[48.125967,11.59832],[48.12578,11.59886],[48.12567,11.599279],[48.125601,11.599742],[48.125577,11.600199],[48.125579,11.600373],[48.125587,11.600574],[48.125603,11.600862],[48.125621,11.601146],[48.125656,11.601425],[48.125727,11.601819],[48.125853,11.602273],[48.125937,11.6025],[48.125962,11.60