# Benutzerdienst: startet ReGo automatisch (ohne root).
# Installation:  mkdir -p ~/.config/systemd/user && cp deploy/rego.service ~/.config/systemd/user/
#                systemctl --user daemon-reload && systemctl --user enable --now rego
#                loginctl enable-linger $USER      # läuft auch ohne Anmeldung
# Pfad unten anpassen (WorkingDirectory) und ggf. node-Pfad: which node
[Unit]
Description=ReGo (Pendler-App)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/rego
Environment=HOST=127.0.0.1
Environment=PORT=8080
# Environment=REGO_INVITE=dein-einladungscode        # optional: neue Geräte brauchen diesen Code
# Environment=REGO_FCM_KEY=...                        # optional: Firebase-Schlüssel für Sofort-Push (oder Datei fcm.json im Datenordner)
ExecStart=/usr/bin/env node server/index.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
